CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT threatactor_id IF NOT EXISTS FOR (n:ThreatActor) REQUIRE n.id IS UNIQUE;
CREATE INDEX threatactor_external IF NOT EXISTS FOR (n:ThreatActor) ON (n.external_id);
CREATE CONSTRAINT malware_id IF NOT EXISTS FOR (n:Malware) REQUIRE n.id IS UNIQUE;
CREATE INDEX malware_external IF NOT EXISTS FOR (n:Malware) ON (n.external_id);
CREATE CONSTRAINT tool_id IF NOT EXISTS FOR (n:Tool) REQUIRE n.id IS UNIQUE;
CREATE INDEX tool_external IF NOT EXISTS FOR (n:Tool) ON (n.external_id);
CREATE CONSTRAINT campaign_id IF NOT EXISTS FOR (n:Campaign) REQUIRE n.id IS UNIQUE;
CREATE INDEX campaign_external IF NOT EXISTS FOR (n:Campaign) ON (n.external_id);
CREATE CONSTRAINT technique_id IF NOT EXISTS FOR (n:Technique) REQUIRE n.id IS UNIQUE;
CREATE INDEX technique_external IF NOT EXISTS FOR (n:Technique) ON (n.external_id);
CREATE CONSTRAINT vulnerability_id IF NOT EXISTS FOR (n:Vulnerability) REQUIRE n.id IS UNIQUE;
CREATE INDEX vulnerability_external IF NOT EXISTS FOR (n:Vulnerability) ON (n.external_id);
CREATE CONSTRAINT weakness_id IF NOT EXISTS FOR (n:Weakness) REQUIRE n.id IS UNIQUE;
CREATE INDEX weakness_external IF NOT EXISTS FOR (n:Weakness) ON (n.external_id);
CREATE CONSTRAINT domain_id IF NOT EXISTS FOR (n:Domain) REQUIRE n.id IS UNIQUE;
CREATE INDEX domain_external IF NOT EXISTS FOR (n:Domain) ON (n.external_id);
CREATE CONSTRAINT ip_id IF NOT EXISTS FOR (n:IP) REQUIRE n.id IS UNIQUE;
CREATE INDEX ip_external IF NOT EXISTS FOR (n:IP) ON (n.external_id);
CREATE CONSTRAINT url_id IF NOT EXISTS FOR (n:URL) REQUIRE n.id IS UNIQUE;
CREATE INDEX url_external IF NOT EXISTS FOR (n:URL) ON (n.external_id);
CREATE CONSTRAINT filehash_id IF NOT EXISTS FOR (n:FileHash) REQUIRE n.id IS UNIQUE;
CREATE INDEX filehash_external IF NOT EXISTS FOR (n:FileHash) ON (n.external_id);
CREATE CONSTRAINT report_id IF NOT EXISTS FOR (n:Report) REQUIRE n.id IS UNIQUE;
CREATE INDEX report_external IF NOT EXISTS FOR (n:Report) ON (n.external_id);
CREATE CONSTRAINT product_id IF NOT EXISTS FOR (n:Product) REQUIRE n.id IS UNIQUE;
CREATE INDEX product_external IF NOT EXISTS FOR (n:Product) ON (n.external_id);
CREATE INDEX entity_name IF NOT EXISTS FOR (n:Entity) ON (n.name);
CREATE INDEX entity_sources IF NOT EXISTS FOR (n:Entity) ON (n.sources);
CREATE CONSTRAINT uses_id IF NOT EXISTS FOR ()-[r:USES]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT exploits_id IF NOT EXISTS FOR ()-[r:EXPLOITS]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT communicates_with_id IF NOT EXISTS FOR ()-[r:COMMUNICATES_WITH]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT resolves_to_id IF NOT EXISTS FOR ()-[r:RESOLVES_TO]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT attributed_to_id IF NOT EXISTS FOR ()-[r:ATTRIBUTED_TO]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT targets_id IF NOT EXISTS FOR ()-[r:TARGETS]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT affects_id IF NOT EXISTS FOR ()-[r:AFFECTS]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT has_weakness_id IF NOT EXISTS FOR ()-[r:HAS_WEAKNESS]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT mentioned_in_id IF NOT EXISTS FOR ()-[r:MENTIONED_IN]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT alias_of_id IF NOT EXISTS FOR ()-[r:ALIAS_OF]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT similar_to_id IF NOT EXISTS FOR ()-[r:SIMILAR_TO]-() REQUIRE r.id IS UNIQUE;
